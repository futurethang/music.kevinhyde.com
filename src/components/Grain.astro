---
/**
 * Spec §8: fixed full-viewport feTurbulence layer behind the content.
 * fractalNoise, baseFrequency 0.85, 3 octaves, desaturated, opacity 0.09,
 * pointer-events none.
 *
 * If this ever costs scroll performance on low-end devices, swap the SVG
 * for a small tiling noise PNG at the same opacity.
 */
---
<svg class="grain" aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <filter id="grain-filter">
    <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch" />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter="url(#grain-filter)" />
</svg>
